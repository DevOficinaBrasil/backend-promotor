# Verifica o JWT de admin emitido pelo backend-ob-ads (POST /usuario/auth) nas
# rotas /admin/* (adminAuthMiddleware). Tem de ter o mesmo valor do JWT_SECRET
# do backend-ob-ads. Não reusa o JWT_SECRET daqui, que assina o login do
# promotor. Sem ele, /admin/* responde 500.
OBADS_JWT_SECRET=

# JWT do portal (emitido pelo backend-communities em /usuario/auth). Usado só
# nas rotas /freelancer/confirmacao-dados (portalAuthMiddleware). Tem de ter o
# mesmo valor do JWT_SECRET do backend-communities; NÃO é o JWT_SECRET acima,
# que assina o login dos promotores. Sem ele a rota responde 500.
PORTAL_JWT_SECRET=
