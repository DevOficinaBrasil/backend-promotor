# Server Config
NODE_ENV=development
PORT=3333
API_URL=http://localhost:3333

# Database Config
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_DATABASE=your_database

# JWT Config
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Encryption Config
CRIPTKEY=1kg1ly2l1lhjk1c8m2m1_1uoh4kbyub9cvb789c

# AWS S3 Config
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your_bucket_name

# CORS Config
CORS_ORIGIN=http://localhost:3000

# WhatsApp Config
WHATSAPP_API_KEY=fake
WHATSAPP_SEND_ENABLED=true
WHATSAPP_ACCOUNT_ID=fake
WHATSAPP_TEMPLATE_NAME_VISITA=atualizacao_dados_visita_oficina
WHATSAPP_BASE_URL=http://localhost:4000
# Must be exactly "true" to allow real sends. Default-off in every environment.
# Also hard-blocked whenever NODE_ENV=test, regardless of this value.
WHATSAPP_SEND_ENABLED=false

# ── Outbox da notificação de visita ────────────────────────────────────────
# Nomes e convenção de valor vêm do outbox do backend-communities, mas
# PREFIXADOS: servidor e .env são copiados entre máquinas aqui, e nomes
# idênticos deixariam um único arquivo copiado ligar também o publisher do
# outro serviço.
#
# Atenção à convenção: estas flags são "1", não "true" como as demais deste
# repo. OUTBOX_VISITA_ENABLED=true deixa o worker desligado em silêncio; o log
# de startup imprime o valor lido justamente por isso.
OUTBOX_VISITA_ENABLED=0
OUTBOX_VISITA_CRON_EXPRESSION=*/1 * * * *
# Linhas por tique, por cópia do servidor. O teto de chamadas ao provider é
# OUTBOX_VISITA_BATCH_SIZE x cópias a cada tique — com o padrão, 20 por minuto
# por cópia. Rever antes de lotes na casa dos milhares.
OUTBOX_VISITA_BATCH_SIZE=20
# Em MINUTOS. Precisa ficar bem acima do timeout de 10s do canal.
OUTBOX_VISITA_LOCK_LEASE_MINUTES=5
# Tentativas antes de uma falha transitória virar FALHOU terminal.
OUTBOX_VISITA_MAX_ATTEMPTS=3
# Janela de envio (America/Sao_Paulo). O lote sai sempre na janela do DIA
# SEGUINTE, qualquer que seja a hora da criacao — hora de envio nao depende de
# quando o ops importou.
NOTIFICACAO_HORA_ENVIO=9
# Fim da janela. Vazio, ou nao maior que o inicio, faz tudo sair na hora cheia.
# Com janela, o lote e distribuido: a rota i de n sai em inicio + (fim-inicio)*i/n.
# E o que impede uma importacao de centenas de rotas de virar rajada contra o
# provider — ver o teto em OUTBOX_VISITA_BATCH_SIZE.
NOTIFICACAO_HORA_ENVIO_FIM=
# SÓ LOCAL. "1" faz toda notificação nascer vencida, em vez de esperar a hora
# marcada. Em produção isso restaura o envio no momento da importação, que é
# exatamente o comportamento que o outbox removeu.
OUTBOX_VISITA_ENVIO_IMEDIATO=0

# LOCAL/STAGING ONLY — leave empty in production. When set, every notification
# is redirected to this single number instead of the oficina's, so the flow can
# be exercised against the real provider without messaging any user. Setting it
# also lifts the NODE_ENV=development block, since nothing can reach a real
# recipient. In production it would swallow every legitimate notification.
WHATSAPP_TEST_PHONE_OVERRIDE=

# Public base URL of the FRONTEND that serves the confirmation page — this is
# what gets embedded in the WhatsApp message, so it must be the user-facing host,
# not this API's host. Falls back to API_URL when unset, which is only correct if
# the two happen to share a domain.
VISITA_CONFIRMACAO_BASE_URL=http://localhost:3000

# Signs the short-lived JWT behind the confirmation magic link. Keep it distinct
# from JWT_SECRET: this token travels through WhatsApp and sits in the
# recipient's chat history, so it must never be able to mint a login session.
# Rotating it invalidates pending links only — no promotor gets logged out.
# Falls back to JWT_SECRET when unset.
VISITA_TOKEN_SECRET=your_visita_token_secret_here

