# Server Config
NODE_ENV=development
PORT=3333
API_URL=http://localhost:3333

# Database Config
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_DATABASE=your_database

# JWT Config
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Encryption Config
CRIPTKEY=1kg1ly2l1lhjk1c8m2m1_1uoh4kbyub9cvb789c

# AWS S3 Config
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your_bucket_name

# CORS Config
CORS_ORIGIN=http://localhost:3000

# WhatsApp Config
WHATSAPP_API_KEY=your_whatsapp_api_key
WHATSAPP_ACCOUNT_ID=your_whatsapp_account_id
WHATSAPP_BASE_URL=https://wpp.oficinabrasil.com.br
WHATSAPP_TEMPLATE_NAME_VISITA=your_approved_template_name
# Must be exactly "true" to allow real sends. Default-off in every environment.
# Also hard-blocked whenever NODE_ENV=test, regardless of this value.
WHATSAPP_SEND_ENABLED=false

# Public base URL of the FRONTEND that serves the confirmation page — this is
# what gets embedded in the WhatsApp message, so it must be the user-facing host,
# not this API's host. Falls back to API_URL when unset, which is only correct if
# the two happen to share a domain.
VISITA_CONFIRMACAO_BASE_URL=http://localhost:3000

