{
  "name": "backend-hijack",
  "version": "1.0.0",
  "description": "Backend API with Express and TypeScript",
  "main": "index.js",
  "scripts": {
    "start": "npx ts-node app.ts",
    "dev": "nodemon app.ts",
    "whatsapp:mock": "npx ts-node scripts/whatsappMockServer.ts",
    "outbox:status": "npx ts-node scripts/outboxConsole.ts status",
    "outbox:tick": "npx ts-node scripts/outboxConsole.ts tick",
    "outbox:agendar": "npx ts-node scripts/outboxConsole.ts agendar",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testMatch \"**/__tests__/unit/**/*.test.ts\"",
    "test:integration": "jest --testMatch \"**/__tests__/integration/**/*.test.ts\"",
    "test:unit:watch": "jest --testMatch \"**/__tests__/unit/**/*.test.ts\" --watch",
    "test:integration:watch": "jest --testMatch \"**/__tests__/integration/**/*.test.ts\" --watch",
    "test:unit:coverage": "jest --testMatch \"**/__tests__/unit/**/*.test.ts\" --coverage",
    "test:integration:coverage": "jest --testMatch \"**/__tests__/integration/**/*.test.ts\" --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
